<%- include('partials/header') %>
<h1 class="h3 mb-3"><i class="bi bi-person-circle me-2"></i>Mi perfil</h1>
<div class="card shadow-sm" style="max-width:520px">
  <form id="formPerfil" class="card-body">
    <div class="mb-3">
      <label class="form-label" for="correo">Correo</label>
      <input class="form-control" id="correo" type="email" disabled>
    </div>
    <div class="mb-3">
      <label class="form-label" for="nombre">Nombre</label>
      <input class="form-control" id="nombre" type="text" required maxlength="100">
    </div>
    <hr>
    <p class="text-muted small">Para cambiar la contraseña, completa estos campos (opcional).</p>
    <div class="mb-3">
      <label class="form-label" for="passwordActual">Contraseña actual</label>
      <input class="form-control" id="passwordActual" type="password" autocomplete="current-password">
    </div>
    <div class="mb-3">
      <label class="form-label" for="passwordNueva">Nueva contraseña (mínimo 8)</label>
      <input class="form-control" id="passwordNueva" type="password" autocomplete="new-password" minlength="8">
    </div>
    <button class="btn btn-aula" type="submit">Guardar cambios</button>
  </form>
</div>
<%- include('partials/footer') %>