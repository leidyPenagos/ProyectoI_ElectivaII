<%- include('partials/header') %>
<div class="login-fondo p-3">
  <div class="card shadow-lg border-0" style="max-width:420px;width:100%">
    <div class="card-body p-4">
      <div class="text-center mb-3">
        <i class="bi bi-journal-bookmark-fill fs-1 text-aula"></i>
        <h1 class="h4 mt-2">AulaOrganizada</h1>
        <p class="text-muted small mb-0">Gestión de la labor docente</p>
      </div>

      <ul class="nav nav-pills nav-fill mb-3">
        <li class="nav-item"><button class="nav-link active" data-bs-toggle="pill" data-bs-target="#tabLogin" type="button">Ingresar</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#tabRegistro" type="button">Crear cuenta</button></li>
      </ul>

      <div id="mensaje" class="alert alert-danger d-none" role="alert"></div>

      <div class="tab-content">
        <div class="tab-pane fade show active" id="tabLogin">
          <form id="formLogin">
            <div class="mb-3">
              <label class="form-label" for="loginCorreo">Correo</label>
              <input class="form-control" id="loginCorreo" type="email" autocomplete="username" required>
            </div>
            <div class="mb-3">
              <label class="form-label" for="loginPassword">Contraseña</label>
              <input class="form-control" id="loginPassword" type="password" autocomplete="current-password" required>
            </div>
            <button class="btn btn-aula w-100" type="submit">Ingresar</button>
          </form>
        </div>

        <div class="tab-pane fade" id="tabRegistro">
          <form id="formRegistro">
            <div class="mb-3">
              <label class="form-label" for="regNombre">Nombre</label>
              <input class="form-control" id="regNombre" type="text" required maxlength="100">
            </div>
            <div class="mb-3">
              <label class="form-label" for="regCorreo">Correo</label>
              <input class="form-control" id="regCorreo" type="email" autocomplete="username" required>
            </div>
            <div class="mb-3">
              <label class="form-label" for="regPassword">Contraseña (mínimo 8 caracteres)</label>
              <input class="form-control" id="regPassword" type="password" autocomplete="new-password" minlength="8" required>
            </div>
            <button class="btn btn-aula w-100" type="submit">Crear cuenta</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>