<%- include('partials/header') %>
<h1 class="h3 mb-3"><i class="bi bi-check2-square me-2"></i>Control de asistencia</h1>

<div class="card shadow-sm mb-3">
  <div class="card-body">
    <div class="row g-3 align-items-end">
      <div class="col-md-6">
        <label class="form-label" for="asignacion">Curso y asignatura</label>
        <select class="form-select" id="asignacion"></select>
      </div>
      <div class="col-md-3">
        <label class="form-label" for="fecha">Fecha</label>
        <input class="form-control" type="date" id="fecha">
      </div>
      <div class="col-md-3">
        <button class="btn btn-aula w-100" id="btnCargar" type="button">Cargar lista</button>
      </div>
    </div>
  </div>
</div>

<div id="panelLista" class="card shadow-sm d-none">
  <div class="tabla-scroll">
    <table class="table align-middle mb-0">
      <thead class="table-light"><tr><th>#</th><th>Estudiante</th><th>Asistencia</th><th>Observación</th></tr></thead>
      <tbody id="cuerpo"></tbody>
    </table>
  </div>
  <div class="card-footer bg-white d-flex flex-wrap gap-2 justify-content-end">
    <button class="btn btn-outline-secondary" id="btnTodosPresentes" type="button">Marcar todos presentes</button>
    <button class="btn btn-aula" id="btnGuardar" type="button"><i class="bi bi-save me-1"></i>Guardar asistencia</button>
  </div>
</div>
<%- include('partials/footer') %>